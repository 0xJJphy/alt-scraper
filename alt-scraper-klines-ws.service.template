[Unit]
Description=Alt-Scraper Futures 15m Klines WebSocket Daemon
After=network.target postgresql.service
OnFailure=alt-scraper-notify@%n.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
EnvironmentFile={{INSTALL_DIR}}/.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{INSTALL_DIR}}/venv/bin/python3 {{INSTALL_DIR}}/futures_ws_daemon.py
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alt-scraper-klines-ws

[Install]
WantedBy=multi-user.target
